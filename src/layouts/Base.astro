---
interface Props { title: string; bg?: string }
const { title, bg } = Astro.props;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>body{margin:0}</style>
  </head>
  <body style={bg ? `background:${bg}` : undefined}>
    <slot />
  </body>
</html>
