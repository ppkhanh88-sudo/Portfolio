---
// /b/<thư-mục>/<Tên> — mở riêng 1 artboard (.dc.html) trong src/dc. Trang /lab nhúng các route này.
import Base from '../../layouts/Base.astro';
import DC from '../../components/DC.astro';
export function getStaticPaths() {
  const files = import.meta.glob('../../dc/**/*.dc.html', { query: '?raw', import: 'default', eager: true });
  return Object.entries(files).map(([p, source]) => ({
    params: { slug: p.replace('../../dc/', '').replace('.dc.html', '') },
    props: { source }
  }));
}
const { source } = Astro.props;
const title = (/<title>([^<]*)<\/title>/.exec(source) || [, 'Artboard'])[1];
---
<Base title={title} bg="#F4F4F2"><DC source={source} /></Base>
